{
  "name": "nuxt-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "oxfmt",
    "knip:production": "knip --production",
    "knip": "knip",
    "lint:eslint": "eslint --fix --cache --concurrency auto",
    "lint:oxlint": "oxlint --type-aware --fix --ignore-path .gitignore",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test:watch": "vitest",
    "test": "vitest run --passWithNoTests",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.4",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-oxlint": "^1.71.0",
    "knip": "^6.21.0",
    "luxon": "^3.7.2",
    "nano-staged": "^1.0.2",
    "nuxt": "^4.4.8",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "8.1.0",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5",
    "zod": "^4.4.3"
  },
  "nano-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "oxlint --fix"
    ],
    "*.{js,ts,vue,css}": "oxfmt --write"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
